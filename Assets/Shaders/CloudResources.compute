#pragma kernel CloudNoiseShapeCS
#pragma kernel CloudNoiseDetailCS
#pragma kernel CloudMapCS

#include "Common.hlsl"
#include "Noise.hlsl"

float ResolutionInv;             // (1 / Resolution) of any texture to which we write here

float CloudTypeBase;
float CumulusHighlight;

float3 CoverageOffset;
float CoverageStrength;

RWTexture3D<float4> OutputNoise; // Writeable 3D texture
RWTexture2D<float2> OutputMap;   // Writeable 2D texture

[numthreads(8, 8, 8)]
void CloudNoiseShapeCS(uint3 id : SV_DispatchThreadID)
{
    float3 uvw = TexelToUV(id, ResolutionInv);
    OutputNoise[id] = ShapeNoiseDecima(uvw);
}

[numthreads(8, 8, 8)]
void CloudNoiseDetailCS(uint3 id : SV_DispatchThreadID)
{
    float3 uvw = TexelToUV(id, ResolutionInv);
    
    const float baseFrequency = 3.0;
    
    // For calculating worley noise we use the length squared 
    // which produces more 'rich' details as oppossed to taking the square root.
    // This detail noise calculation is based on Sebastien Hillaire's implementation where he also uses length squared.
    const int metric = METRIC_SQUARED;
    
    float worleyNoise0 = 1.0 - WorleyNoise(uvw, baseFrequency * 1.0, 0.0, metric);
    float worleyNoise1 = 1.0 - WorleyNoise(uvw, baseFrequency * 2.0, 0.0, metric);
    float worleyNoise2 = 1.0 - WorleyNoise(uvw, baseFrequency * 4.0, 0.0, metric);
    float worleyNoise3 = 1.0 - WorleyNoise(uvw, baseFrequency * 8.0, 0.0, metric);
    float worleyFBM0 = worleyNoise0 * 0.625 + worleyNoise1 * 0.25 + worleyNoise2 * 0.125;
    float worleyFBM1 = worleyNoise1 * 0.625 + worleyNoise2 * 0.25 + worleyNoise3 * 0.125;
    float worleyFBM2 = worleyNoise2 * 0.75 + worleyNoise3 * 0.25;

    OutputNoise[id] = float4(worleyFBM0, worleyFBM1, worleyFBM2, 1.0);
}

float CloudCoverageStratus(float3 inUVW)
{
    // Cloud Type Base = 0.2
    // Cumulus Highlight = 0.21
    
    float all = AlligatorDecima(inUVW + float3(0.07, 0.08, 0.0), 2);
    all = Remap(all, 0.0, 1.0, 0.0, 5.0);
    
    float all2 = AlligatorDecima(inUVW + float3(0.07, 0.08, 0.0), 4);
    all2 = Remap(all2, 0.0, 1.0, 0.0, 5.0 * 0.25);
    
    float all3 = AlligatorDecima(inUVW + float3(0.07, 0.08, 0.0), 5);
    all3 = Remap(all3, 0.0, 1.0, 0.0, 5.0 * 0.07);
    
    return all * all2 + all3;
}

float CloudCoverageStratocumulus(float3 inUVW)
{
    // A low frequency noise modulates cloud coverage to simulate the 
    // large regions where air masses overlap and clouds are allowed to form.
    float lowFreqBase = PerlinFBM(inUVW + float3(2.2, -0.09, -0.78), 3, 4, false);
    lowFreqBase = Remap(lowFreqBase, -0.2, 1.0, 0.0, 16);
    
    float highFreqBase = PerlinFBM(inUVW + float3(2.2, -0.09, -0.78), 5, 6, false);
    highFreqBase = Remap(highFreqBase, -0.2, 1.0, 0.0, 0.7);
    
    return lowFreqBase * highFreqBase;
}

float CloudCoverageCumulus(float3 inUVW)
{
    // Cloud Type Base = 0.8
    // Cumulus Highlight = 0.69
    
    float all = AlligatorDecima(inUVW + float3(-0.09, 0.08, 0.0), 2);
    all = Remap(all, 0.0, 1.0, 0.0, 5.4);
    
    all *= all;
    
    float all2 = AlligatorDecima(inUVW + float3(-0.09, 0.08, 0.0), 4);
    return all2 * all * all2;
}

float CloudCoverageTest(float3 inUVW)
{
    float lowFreqBase2 = PerlinFBM(inUVW + CoverageOffset + float3(0.4, 0.5, 0.1), 5, 4, false);
    lowFreqBase2 = Remap(lowFreqBase2, -0.2, 1.0, 0.0, CoverageStrength);
    
    float highFreqBase = WorleyDecima(inUVW).g;
    highFreqBase = Remap(highFreqBase, -0.2, 1.0, 0.0, 0.6);
    
    return lowFreqBase2 * highFreqBase;
}

float CloudTypeAlligator(float3 inUVW, float inCloudTypeBase, float inCumulusHighlight)
{
    float cloudType = AlligatorDecima(inUVW, 8);
    
    // Raises the lower values
    cloudType = pow(cloudType, inCloudTypeBase);
    
    // 'Highlight' cumulus clouds
    cloudType = Remap(cloudType, 0.0, 1, 0.0, inCumulusHighlight);
    
    return cloudType;
}

float CloudTypePerlin(float3 inUVW, float inCloudTypeBase, float inCumulusHighlight)
{
    float cloudType = PerlinFBM(inUVW, 22, 6, true);
    
    // Raises the lower values
    cloudType = pow(cloudType, inCloudTypeBase);
    
    // 'Highlight' cumulus clouds
    cloudType = Remap(cloudType, 0.0, 1, 0.0, inCumulusHighlight);
    
    return cloudType;
}

[numthreads(8, 8, 1)]
void CloudMapCS(uint3 id : SV_DispatchThreadID)
{
    float3 uvw = TexelToUV(id, ResolutionInv);
    
    // Set these two values to store coverage and cloud type
    float coverage;
    float cloudType;
    
    // Use one of the several functions contained in this file 
    // to generate coverage noise or create your own
    coverage = CloudCoverageTest(uvw);
    
    // We used CloudTypeAlligator and CloudTypePerlin for generating noise for cloud type.
    // They both use CloudTypeBase, CumulusHighlight in the same way to control the final result.
    cloudType = CloudTypeAlligator(uvw, CloudTypeBase, CumulusHighlight);
    
    // IF YOU MAKE CHANGES TO THIS CODE, SAVE IT AND CHANGE SOME VALUE IN THE RENDERER FEATURE INSPECTOR.
    // THIS WAY YOU FORCE THE RENDERER FEATURE TO EXECUTE THIS CODE AND CREATE YOUR NEW CLOUD MAP.
        
    OutputMap[id.xy] = saturate(float4(coverage, cloudType, 0.0, 0.0));
}
